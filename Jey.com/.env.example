# Production canonical URL (defaults to https://jeyavardhan.dev if unset)
NEXT_PUBLIC_SITE_URL=https://jeyavardhan.dev

# Google Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Google Gemini API Key for Homepage AI Assistant (Optional)
# Get a key at: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=

# Upstash Redis for Chat Rate Limiting (Optional - graceful bypass if unset)
# Get these from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
