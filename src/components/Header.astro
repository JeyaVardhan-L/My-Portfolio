---
import { url } from '../lib/site';
import { SITE } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const links = [
  { href: '/projects/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
---

<header class="hd">
  <div class="wrap hd-bar">
    <a class="hd-brand" href={url('/')}>
      <i aria-hidden="true"></i>
      <span>{SITE.name}</span>
    </a>
    <nav class="hd-nav" aria-label="Primary">
      {
        links.map((l) => (
          <a href={url(l.href)} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <button class="hd-switch" type="button" role="switch" aria-checked="false" aria-label="Hardware side" data-side-switch>
      <span class="o o-sw" aria-hidden="true">Software</span>
      <span class="o o-hw" aria-hidden="true">Hardware</span>
    </button>
  </div>
</header>

<style>
  .hd {
    position: relative;
    z-index: 20;
  }

  .hd-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px 32px;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule);
    font: 400 11px/1 var(--mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .hd-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .hd-brand i {
    width: 11px;
    height: 11px;
    background: var(--blue);
  }

  .hd-nav {
    display: flex;
    justify-content: flex-end;
    gap: clamp(16px, 2.6vw, 32px);
  }

  .hd-nav a {
    text-decoration: none;
    color: var(--muted);
  }

  .hd-nav a:hover,
  .hd-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .hd-nav a[aria-current='page']::before {
    content: '/';
    margin-right: 4px;
    color: var(--blue);
  }

  .hd-switch {
    display: inline-flex;
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .o {
    padding: 7px 10px;
    color: var(--muted);
    transition: background 0.4s var(--ease), color 0.4s var(--ease);
  }

  :global([data-side='software']) .o-sw,
  :global([data-side='hardware']) .o-hw {
    background: var(--ink);
    color: var(--bg);
  }

  :global([data-side='software']) .hd-switch:hover .o-hw,
  :global([data-side='hardware']) .hd-switch:hover .o-sw {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .hd-bar {
      grid-template-columns: 1fr auto;
    }

    .hd-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      padding-top: 6px;
    }
  }
</style>
