---
import { SITE } from '../site';
import { url } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const links = [
  { href: '/projects/', label: 'work' },
  { href: '/writing/', label: 'writing' },
  { href: '/about/', label: 'about' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a href={url(l.href)} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      <button class="kbd" type="button" data-palette-open aria-label="Open the quick menu" title="Quick menu">
        <span aria-hidden="true">⌘K</span>
      </button>
      <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Hardware side" data-side-switch>
        <span class="opt opt-sw" aria-hidden="true">Software</span>
        <span class="opt opt-hw" aria-hidden="true">Hardware</span>
        <span class="thumb" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 2rem;
  }

  .brand {
    font-family: var(--sans);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    justify-content: flex-end;
    gap: clamp(1.1rem, 2.5vw, 2rem);
    font-family: var(--sans);
    font-size: 0.98rem;
    letter-spacing: 0.1em;
  }

  .nav a {
    text-decoration: none;
    color: var(--muted);
    position: relative;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.1em;
    bottom: -0.3em;
    height: 1px;
    background: currentColor;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kbd {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 0.3rem 0.45rem;
    line-height: 1;
    transition: color 0.2s, border-color 0.2s;
  }

  .kbd:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 3px;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    isolation: isolate;
  }

  .opt {
    position: relative;
    z-index: 1;
    padding: 0.38rem 0.7rem;
    text-align: center;
    color: var(--muted);
    transition: color 0.3s;
  }

  :global([data-side='software']) .switch:hover .opt-hw,
  :global([data-side='hardware']) .switch:hover .opt-sw {
    color: var(--ink);
  }

  .thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: var(--ink);
    z-index: 0;
    transition: transform 0.6s var(--ease-out);
  }

  :global([data-side='software']) .opt-sw,
  :global([data-side='hardware']) .opt-hw {
    color: var(--paper);
  }

  :global([data-side='hardware']) .thumb {
    transform: translateX(100%);
  }

  @media (hover: none), (pointer: coarse) {
    .kbd {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .bar {
      grid-template-columns: 1fr auto;
    }

    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
    }
  }
</style>
