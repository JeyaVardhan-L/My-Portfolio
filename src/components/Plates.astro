---
import { Image } from 'astro:assets';
import Diagram from './Diagram.astro';
import { pad, sideShort, url, year, type Project } from '../lib/site';

interface Props {
  items: Project[];
}

const { items } = Astro.props;
---

<ol class="plates">
  {
    items.map((p, i) => {
      const c = p.data.cover;
      const portrait = c ? c.height > c.width : false;
      return (
        <li class="plate">
          <a href={url(`/projects/${p.id}/`)} class="plate-a">
            <div class:list={['plate-media', { portrait, drawn: !c }]}>
              {c ? (
                <Image src={c} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
              ) : (
                <Diagram id={p.id} />
              )}
              <span class="plate-go" aria-hidden="true">/</span>
            </div>
            <div class="plate-meta">
              <span class="label">{pad(i + 1)}</span>
              <span class="plate-title">
                {p.data.title}
                {p.data.status === 'in progress' && <span class="label plate-flag">In progress</span>}
              </span>
              <span class="label plate-side">
                {sideShort[p.data.side]} · {year(p.data.date)}
              </span>
              <span class="plate-sum">{p.data.summary}</span>
            </div>
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .plates {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px 32px;
  }

  .plate-a {
    display: block;
    text-decoration: none;
  }

  .plate-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--plate);
  }

  .plate-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 1.4s var(--ease);
  }

  .plate-media.portrait :global(img) {
    object-fit: contain;
    object-position: center;
    padding-block: 4%;
  }

  .plate-media.drawn {
    padding: 4% 6%;
  }

  .plate-a:hover .plate-media :global(img) {
    transform: scale(1.035);
  }

  .plate-media.portrait :global(img),
  .plate-a:hover .plate-media.portrait :global(img) {
    transform: none;
  }

  .plate-go {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--indigo);
    color: #fff;
    font: 500 14px/1 var(--mono);
    transform: translateY(100%);
    transition: transform 0.5s var(--ease);
  }

  .plate-a:hover .plate-go,
  .plate-a:focus-visible .plate-go {
    transform: none;
  }

  .plate-meta {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 6px 12px;
    align-items: baseline;
    padding-top: 18px;
  }

  .plate-title {
    font-size: clamp(24px, 2.3vw, 32px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    transition: color 0.3s;
  }

  .plate-a:hover .plate-title {
    color: var(--accent);
  }

  .plate-flag {
    margin-left: 10px;
    vertical-align: middle;
    color: var(--accent);
  }

  .plate-sum {
    grid-column: 2 / -1;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
    max-width: 36em;
  }

  @media (max-width: 760px) {
    .plates {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .plate-meta {
      grid-template-columns: 32px minmax(0, 1fr);
    }

    .plate-side {
      grid-column: 2;
    }
  }
</style>
