---
// The gallery: photos floating on a slowly turning sphere, opened from a
// "Gallery" button anywhere on the page (any element with data-gallery-open).
// Drag to spin it, click a photo to see it large.
//
// Photos come from src/assets/gallery/. Until there are any, the inspiration
// placeholders stand in.
import { getImage } from 'astro:assets';

const pick = (mods: Record<string, { default: ImageMetadata }>) =>
  Object.entries(mods)
    .sort(([a], [b]) => b.localeCompare(a))
    .map(([, m]) => m.default);

const own = pick(import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif}', { eager: true }));
const photos = own.length
  ? own
  : pick(import.meta.glob<{ default: ImageMetadata }>('../assets/inspiration/*.{jpg,jpeg,png,webp,avif}', { eager: true }));

const sized = await Promise.all(
  photos.map(async (p) => ({
    thumb: (await getImage({ src: p, width: 260, format: 'webp' })).src,
    full: (await getImage({ src: p, width: 1600, format: 'webp' })).src,
  })),
);

// Spread the tiles evenly over the sphere (Fibonacci lattice). Few photos are
// repeated so the sphere always looks full.
const count = sized.length ? Math.min(Math.max(sized.length, 46), 120) : 0;
const golden = 180 * (3 - Math.sqrt(5));
const tiles = Array.from({ length: count }, (_, i) => {
  const y = 1 - (2 * (i + 0.5)) / count;
  return {
    ...sized[i % sized.length],
    lat: ((Math.asin(y) * 180) / Math.PI).toFixed(2),
    lon: ((i * golden) % 360).toFixed(2),
  };
});
---

<dialog class="gal darkroom" id="gallery" aria-label="Gallery">
  <div class="gal-top">
    <p class="label">Gallery · drag to spin · click a photo</p>
    <button type="button" class="label gal-x" data-gal-close>Close ✕</button>
  </div>
  <div class="gal-stage">
    <div class="gal-ball">
      {
        tiles.map((t) => (
          <button type="button" class="gal-tile" data-full={t.full} style={`--lat:${t.lat}deg;--lon:${t.lon}deg`} aria-label="Open photo">
            <img src={t.thumb} alt="" loading="lazy" decoding="async" draggable="false" />
          </button>
        ))
      }
    </div>
  </div>
  <figure class="gal-view" hidden>
    <img alt="" />
    <button type="button" class="label gal-back">← Back to the sphere</button>
  </figure>
</dialog>

<script>
  const dlg = document.getElementById('gallery') as HTMLDialogElement | null;
  if (dlg) {
    const ball = dlg.querySelector<HTMLElement>('.gal-ball')!;
    const stage = dlg.querySelector<HTMLElement>('.gal-stage')!;
    const view = dlg.querySelector<HTMLElement>('.gal-view')!;
    const big = view.querySelector('img')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let rx = -12, ry = 0, vx = 0, vy = still ? 0 : 0.09;
    let raf = 0, dragging = false, moved = 0, lx = 0, ly = 0;

    const paint = () => {
      ball.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
    };
    const tick = () => {
      if (!dragging) {
        ry += vy;
        rx += vx;
        vx *= 0.94;
        if (!still) vy += (0.09 - vy) * 0.02; // ease back to the idle spin
        rx = Math.max(-60, Math.min(60, rx));
      }
      paint();
      raf = requestAnimationFrame(tick);
    };

    const open = () => {
      if (dlg.open) return;
      dlg.showModal();
      document.documentElement.classList.add('gal-on');
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    };
    const shut = () => {
      if (!view.hidden) return closeView();
      dlg.close();
    };
    const closeView = () => {
      view.hidden = true;
      big.removeAttribute('src');
    };

    dlg.addEventListener('close', () => {
      cancelAnimationFrame(raf);
      closeView();
      document.documentElement.classList.remove('gal-on');
    });
    // Esc closes the big photo first, then the gallery.
    dlg.addEventListener('cancel', (e) => {
      if (!view.hidden) {
        e.preventDefault();
        closeView();
      }
    });

    document.addEventListener('click', (e) => {
      if ((e.target as Element).closest('[data-gallery-open]')) open();
    });
    dlg.querySelector('[data-gal-close]')!.addEventListener('click', () => dlg.close());
    view.addEventListener('click', closeView);

    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = 0;
      lx = e.clientX;
      ly = e.clientY;
      vx = vy = 0;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lx, dy = e.clientY - ly;
      lx = e.clientX;
      ly = e.clientY;
      moved += Math.abs(dx) + Math.abs(dy);
      vy = dx * 0.25;
      vx = -dy * 0.25;
      ry += vy;
      rx = Math.max(-60, Math.min(60, rx + vx));
    });
    window.addEventListener('pointerup', () => {
      dragging = false;
    });

    ball.addEventListener('click', (e) => {
      const tile = (e.target as Element).closest<HTMLElement>('.gal-tile');
      if (!tile || moved > 6) return;
      big.src = tile.dataset.full ?? '';
      view.hidden = false;
    });

    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) shut();
    });
  }
</script>

<style>
  .gal {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: radial-gradient(circle at 50% 55%, #10131f 0%, var(--bg) 70%);
    color: var(--ink);
    overflow: hidden;
  }

  .gal::backdrop {
    background: #060607;
  }

  :global(html.gal-on) {
    overflow: hidden;
  }

  .gal-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px var(--gutter);
  }

  .gal-x,
  .gal-back {
    padding: 8px 10px;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .gal-x:hover,
  .gal-back:hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .gal-stage {
    --r: min(34vmin, 320px);
    --t: min(10.5vmin, 96px);
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1100px;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .gal-stage:active {
    cursor: grabbing;
  }

  .gal-ball {
    position: relative;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  .gal-tile {
    position: absolute;
    left: calc(var(--t) / -2);
    top: calc(var(--t) * -0.65);
    width: var(--t);
    height: calc(var(--t) * 1.3);
    padding: 0;
    border: 0;
    background: #1a1d29;
    cursor: pointer;
    backface-visibility: hidden;
    transform: rotateY(var(--lon)) rotateX(var(--lat)) translateZ(var(--r));
    box-shadow: 0 0 0 1px rgb(169 182 255 / 0.18);
    transition: box-shadow 0.3s;
  }

  .gal-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .gal-tile:hover,
  .gal-tile:focus-visible {
    box-shadow: 0 0 0 2px var(--blue);
    outline: none;
  }

  .gal-view {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 16px;
    margin: 0;
    padding: 64px var(--gutter) 32px;
    background: rgb(6 6 7 / 0.92);
    cursor: zoom-out;
  }

  .gal-view[hidden] {
    display: none;
  }

  .gal-view img {
    max-width: 100%;
    max-height: calc(100dvh - 160px);
    object-fit: contain;
  }
</style>
