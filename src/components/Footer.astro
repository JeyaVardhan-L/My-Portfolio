---
import Art from './Art.astro';
import Btn from './Btn.astro';
import footerArt from '../assets/art/footer.jpg';
import { SITE } from '../site';
import { url } from '../lib/site';

const tel = SITE.phone ? `tel:${SITE.phone.replace(/[^\d+]/g, '')}` : '';
const actions = [
  SITE.email ? { label: SITE.email, href: `mailto:${SITE.email}` } : { label: 'Write to me on GitHub', href: SITE.github },
  SITE.phone && { label: SITE.phone, href: tel, ghost: true },
  SITE.resume && { label: 'Résumé', href: url(SITE.resume), ghost: true },
].filter(Boolean) as { label: string; href: string; ghost?: boolean }[];

const pages = [
  { label: 'Work', href: url('/projects/') },
  { label: 'Writing', href: url('/writing/') },
  { label: 'About', href: url('/about/') },
  { label: 'Inspiration', href: url('/inspiration/') },
];
const elsewhere = [
  SITE.email && { label: 'Email', href: `mailto:${SITE.email}` },
  SITE.phone && { label: 'Phone', href: tel },
  { label: 'GitHub', href: SITE.github },
  SITE.linkedin && { label: 'LinkedIn', href: SITE.linkedin },
  { label: 'RSS', href: url('/rss.xml') },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="ft">
  <div class="wrap ft-grid">
    <div class="ft-brand">
      <p class="ft-name"><i aria-hidden="true"></i>{SITE.name} <span lang="te">{SITE.nameTe}</span></p>
      <p class="ft-line">Have something that needs building? I'd like to hear about it.</p>
      <div class="ft-actions">
        {actions.map((a) => <Btn label={a.label} href={a.href} ghost={a.ghost} />)}
      </div>
    </div>
    <div>
      <p class="ft-h">Menu</p>
      <ul>{pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="ft-h">Elsewhere</p>
      <ul>
        {
          elsewhere.map((l) => (
            <li>
              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="ft-h">Local time</p>
      <p class="ft-time"><span data-clock>--:--</span> IST</p>
      <p class="label">{SITE.location}</p>
    </div>
  </div>
  <div class="wrap ft-fine label">
    <span>© {new Date().getFullYear()} {SITE.fullName}</span>
    <span>{SITE.art.footer}</span>
  </div>
  <Art src={footerArt} variant="footer" />
</footer>

<style>
  .ft {
    margin-top: var(--gap);
    padding-top: 56px;
    border-top: 1px solid var(--rule);
  }

  .ft-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px 32px;
  }

  .ft-name {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 400 26px/1 var(--serif);
    color: var(--blue);
  }

  .ft-name i {
    width: 11px;
    height: 11px;
    background: var(--blue);
  }

  .ft-name span {
    font: 400 14px/1 var(--sans);
    color: var(--muted);
  }

  .ft-line {
    margin-top: 16px;
    max-width: 22em;
    font-size: 15px;
    line-height: 1.5;
    font-style: italic;
    color: var(--ink-2);
  }

  .ft-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .ft-h {
    margin-bottom: 16px;
    font: 400 20px/1 var(--serif);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .ft-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .ft-grid ul a {
    text-decoration: none;
    font-size: 15px;
    color: var(--ink-2);
  }

  .ft-grid ul a:hover {
    color: var(--blue);
  }

  .ft-time {
    font: 400 15px/1.5 var(--sans);
    color: var(--ink-2);
  }

  .ft-fine {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 64px;
    font-size: 10px;
  }

  .ft :global(.art--footer) {
    margin-top: -8px;
  }

  .ft :global(.art--footer .art-in) {
    height: clamp(200px, 30vw, 520px);
  }

  .ft :global(.art--footer img) {
    object-position: 50% 100%;
  }

  @media (max-width: 820px) {
    .ft-grid {
      grid-template-columns: 1fr 1fr;
    }

    .ft-brand {
      grid-column: 1 / -1;
    }
  }
</style>
