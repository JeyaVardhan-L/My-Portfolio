---
import { getImage } from 'astro:assets';
import { diagramUrlOf, onSide, pad, sideClass, sideShort, url, year, type Project } from '../lib/site';

interface Props {
  items: Project[];
  filterBySide?: boolean;
}

const { items, filterBySide = false } = Astro.props;

let swN = 0;
let hwN = 0;
const nums = items.map((p) => ({
  sw: onSide(p, 'software') ? ++swN : 0,
  hw: onSide(p, 'hardware') ? ++hwN : 0,
}));

const rows = await Promise.all(
  items.map(async (p, i) => {
    const img = p.data.cover
      ? (await getImage({ src: p.data.cover, width: 720, format: 'webp' })).src
      : diagramUrlOf(p.id);
    return { p, n: nums[i], img, drawn: !p.data.cover };
  }),
);
---

<ol class="pl">
  {
    rows.map(({ p, n, img, drawn }) => (
      <li class:list={['pr', filterBySide && sideClass(p.data.side)]}>
        <a href={url(`/projects/${p.id}/`)} data-peek-title={p.data.title} data-peek-img={img} data-peek-drawn={drawn ? '' : undefined}>
          <span class="label pr-n">
            {n.sw > 0 && <span class="sw-only">{pad(n.sw)}</span>}
            {n.hw > 0 && <span class="hw-only">{pad(n.hw)}</span>}
          </span>
          <span class="pr-main">
            <span class="pr-title">{p.data.title}</span>
            <span class="pr-sum">{p.data.summary}</span>
          </span>
          <span class="label pr-meta">
            <span>{sideShort[p.data.side]} · {year(p.data.date)}</span>
            {p.data.status === 'in progress' && <span class="pr-flag">In progress</span>}
          </span>
          <span class="pr-go" aria-hidden="true">
            /
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .pl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .pr a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 180px 28px;
    gap: 16px;
    align-items: baseline;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }

  .pr-title {
    display: block;
    font-size: clamp(26px, 2.9vw, 42px);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color 0.3s, transform 0.6s var(--ease);
  }

  .pr a:hover .pr-title {
    color: var(--accent);
    transform: translateX(10px);
  }

  .pr-sum {
    display: block;
    margin-top: 10px;
    max-width: 40em;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
  }

  .pr-meta {
    display: grid;
    gap: 4px;
    text-align: right;
  }

  .pr-flag {
    color: var(--accent);
  }

  .pr-go {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font: 500 12px/1 var(--mono);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }

  .pr a:hover .pr-go {
    background: var(--indigo);
    color: #fff;
    box-shadow: none;
  }

  @media (max-width: 720px) {
    .pr a {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
      padding-block: 22px;
    }

    .pr-meta {
      grid-column: 2;
      text-align: left;
      display: flex;
      gap: 12px;
    }

    .pr-go {
      display: none;
    }
  }
</style>
