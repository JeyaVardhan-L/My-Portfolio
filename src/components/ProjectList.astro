---
import { getImage } from 'astro:assets';
import { onSide, pad, sideClass, sideShort, url, year, type Project } from '../lib/site';

interface Props {
  items: Project[];

  filterBySide?: boolean;
}

const { items, filterBySide = false } = Astro.props;
let swN = 0;
let hwN = 0;
const nums = items.map((p) => ({ sw: onSide(p, 'software') ? ++swN : 0, hw: onSide(p, 'hardware') ? ++hwN : 0 }));

const rows = await Promise.all(
  items.map(async (p, i) => {
    const img = p.data.cover ? await getImage({ src: p.data.cover, width: 640, format: 'webp' }) : null;
    const lines = p.data.specs.slice(0, 3).map((s) => `${s.label}: ${s.value}`);
    return { p, n: nums[i], img: img?.src, lines: JSON.stringify(lines) };
  }),
);
---

<ol class="plist">
  {
    rows.map(({ p, n, img, lines }) => (
      <li class:list={['prow', filterBySide && sideClass(p.data.side)]}>
        <a
          class="prow-link"
          href={url(`/projects/${p.id}/`)}
          data-peek-title={p.data.title}
          data-peek-img={img}
          data-peek-lines={lines}
        >
          <span class="prow-n label">
            {n.sw > 0 && <span class="sw-only">{pad(n.sw)}</span>}
            {n.hw > 0 && <span class="hw-only">{pad(n.hw)}</span>}
          </span>
          <span class="prow-main">
            <span class="prow-title">
              {p.data.title}
              {p.data.status === 'in progress' && <span class="prow-status label">in progress</span>}
            </span>
            <span class="prow-sum">{p.data.summary}</span>
          </span>
          <span class="prow-meta label">
            <span>{sideShort[p.data.side]}</span>
            <span>{year(p.data.date)}</span>
          </span>
          <span class="prow-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .plist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .prow {
    border-bottom: 1px solid var(--rule);
  }

  .prow-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.25rem;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.6rem 0.5rem;
    text-decoration: none;
  }

  .prow-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent-soft);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .prow-link:hover::before,
  .prow-link:focus-visible::before {
    transform: scaleX(1);
  }

  .prow-title {
    display: block;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    transition: transform 0.6s var(--ease-out);
  }

  .prow-link:hover .prow-title {
    transform: translateX(0.4rem);
  }

  .prow-status {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.6rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--accent);
  }

  .prow-sum {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 44rem;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.95em;
    line-height: 1.5;
  }

  .prow-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .prow-arrow {
    color: var(--muted);
    transition: transform 0.5s var(--ease-out), color 0.3s;
  }

  .prow-link:hover .prow-arrow {
    color: var(--ink);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .prow-link {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.4rem 0.75rem;
      padding-block: 1.3rem;
    }

    .prow-meta {
      grid-column: 2;
      flex-direction: row;
      gap: 0.9rem;
    }

    .prow-arrow {
      display: none;
    }
  }
</style>
