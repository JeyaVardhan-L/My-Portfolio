---
const procs = [
  { name: 'cat', x: 45, pid: 4022 },
  { name: 'grep', x: 235, pid: 4023 },
  { name: 'wc', x: 425, pid: 4024 },
];
const packets = [0, -0.5, -1];
---

<svg class="diagram anim" viewBox="0 0 600 440" role="img" aria-labelledby="pl-title">
  <title id="pl-title">A shell forks cat, grep and wc, and joins them with pipes so data flows from one to the next</title>
  <defs>
    <marker id="pl-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="currentColor"></path>
    </marker>
    <path id="pl-p1" d="M175 278 H235"></path>
    <path id="pl-p2" d="M365 278 H425"></path>
    <path id="pl-in" d="M300 78 V114"></path>
    <path id="pl-out" d="M490 308 V354"></path>
  </defs>

  <g class="ln thin">
    <path d="M8 18 H28 M18 8 V28 M572 18 H592 M582 8 V28 M8 422 H28 M18 412 V432 M572 422 H592 M582 412 V432"></path>
  </g>

  <text class="s" x="40" y="22">STDIN · TYPED AT THE PROMPT</text>
  <rect class="box solid" x="40" y="30" width="520" height="46" rx="6"></rect>
  <text class="t" x="60" y="58">
    $ cat access.log | grep 404 | wc -l<tspan dx="4">_<animate attributeName="fill-opacity" values="1;0" calcMode="discrete" dur="1.1s" repeatCount="indefinite"></animate></tspan>
  </text>

  <path class="ln" d="M300 76 V114" marker-end="url(#pl-arr)"></path>
  <circle r="3" class="fillc">
    <animateMotion dur="3s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.25;1" calcMode="linear">
      <mpath href="#pl-in"></mpath>
    </animateMotion>
  </circle>

  <rect class="box solid" x="225" y="118" width="150" height="50" rx="6"></rect>
  <text class="t mid" x="300" y="140">forgeshell</text>
  <text class="s mid" x="300" y="157">PID 4021 · PARENT</text>

  <path class="ln dash" d="M300 168 V204 H110 V248 M300 204 V248 M300 204 H490 V248">
    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="1s" repeatCount="indefinite"></animate>
  </path>
  <circle cx="300" cy="204" r="3" class="fillc"></circle>
  <text class="s" x="316" y="196">FORK() + EXECVP() ×3</text>

  {
    procs.map((p) => (
      <g>
        <rect class="box solid" x={p.x} y="250" width="130" height="56" rx="6" />
        <text class="t mid" x={p.x + 65} y="274">
          {p.name}
        </text>
        <text class="s mid" x={p.x + 65} y="292">
          PID {p.pid}
        </text>
      </g>
    ))
  }

  <path class="ln" d="M175 272 H235 M175 284 H235 M365 272 H425 M365 284 H425"></path>
  <text class="s mid" x="205" y="263">PIPE</text>
  <text class="s mid" x="395" y="263">PIPE</text>
  {
    ['#pl-p1', '#pl-p2'].map((href) =>
      packets.map((b) => (
        <rect x="-4" y="-2.5" width="8" height="5" rx="1" class="fillc">
          <animateMotion dur="1.5s" begin={`${b}s`} repeatCount="indefinite">
            <mpath href={href} />
          </animateMotion>
        </rect>
      )),
    )
  }

  <path class="ln" d="M490 306 V354" marker-end="url(#pl-arr)"></path>
  <circle r="3" class="fillc">
    <animateMotion dur="3s" repeatCount="indefinite" keyPoints="0;0;1;1" keyTimes="0;0.55;0.8;1" calcMode="linear">
      <mpath href="#pl-out"></mpath>
    </animateMotion>
  </circle>
  <rect class="box solid" x="425" y="358" width="130" height="48" rx="6"></rect>
  <text class="s mid" x="490" y="377">STDOUT</text>
  <text class="t mid" x="490" y="397">
    37
    <animate attributeName="fill-opacity" values="0.25;0.25;1;1" keyTimes="0;0.78;0.82;1" dur="3s" repeatCount="indefinite"></animate>
  </text>

  <text class="s" x="45" y="364">DUP2()</text>
  <text class="s" x="148" y="364">STDOUT → WRITE END</text>
  <text class="s" x="45" y="382">WAITPID()</text>
  <text class="s" x="148" y="382">REAPS ALL THREE</text>
  <text class="s" x="45" y="400">TCSETPGRP()</text>
  <text class="s" x="148" y="400">HANDS BACK THE TTY</text>
</svg>
