---
import { getImage } from 'astro:assets';
import { onSide, pad, sideClass, sideShort, url, year, type Project } from '../lib/site';

interface Props {
  items: Project[];
  /** number of the first row (home page lists continue numbering after "see more") */
  start?: number;
  /** hide each row on the side it does not belong to, numbering each side separately */
  filter?: boolean;
}

const { items, start = 1, filter = false } = Astro.props;

let swN = 0;
let hwN = 0;
const rows = await Promise.all(
  items.map(async (p, i) => {
    const sw = onSide(p, 'software') ? ++swN : 0;
    const hw = onSide(p, 'hardware') ? ++hwN : 0;
    const img = p.data.cover ? (await getImage({ src: p.data.cover, width: 720, format: 'webp' })).src : undefined;
    return { p, n: start + i, sw, hw, img };
  }),
);
---

<ol class="rows">
  {
    rows.map(({ p, n, sw, hw, img }) => (
      <li class:list={['row', filter && sideClass(p.data.side)]}>
        <a href={url(`/projects/${p.id}/`)} data-peek-title={p.data.title} data-peek-img={img}>
          <span class="label row-n">
            {filter ? (
              <>
                {sw > 0 && <span class="sw-only">{pad(sw)}</span>}
                {hw > 0 && <span class="hw-only">{pad(hw)}</span>}
              </>
            ) : (
              pad(n)
            )}
          </span>
          <span class="row-main">
            <span class="row-title">
              {p.data.title}
              {p.data.status === 'in progress' && <span class="label row-flag">In progress</span>}
            </span>
            <span class="row-sum">{p.data.summary}</span>
          </span>
          <span class="label row-meta">
            {sideShort[p.data.side]} · {year(p.data.date)}
          </span>
        </a>
        {
          p.data.repo && (
            <a class="label row-repo" href={p.data.repo} rel="noopener" target="_blank" aria-label={`${p.data.title} on GitHub`}>
              Repo ↗
            </a>
          )
        }
      </li>
    ))
  }
</ol>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    position: relative;
  }

  .row > a:first-child {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 100px 76px;
    gap: 16px;
    align-items: baseline;
    padding: 15px 12px;
    margin-inline: -12px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background 0.4s var(--ease);
  }

  .row > a:first-child:hover,
  .row > a:first-child:focus-visible {
    background: var(--bg-2);
  }

  .row-title {
    display: block;
    font-size: clamp(17px, 1.3vw, 19px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: color 0.3s;
  }

  .row > a:first-child:hover .row-title {
    color: var(--blue);
  }

  .row-flag {
    margin-left: 10px;
    vertical-align: middle;
    color: var(--blue);
  }

  .row-sum {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 3px;
    max-width: 52em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .row-meta {
    text-align: right;
  }

  /* the repo button sits beside the row link (a link can't hold a link) */
  .row-repo {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: 6px 8px;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink-2);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: color 0.3s, background 0.3s, box-shadow 0.3s;
  }

  .row-repo:hover,
  .row-repo:focus-visible {
    color: #fff;
    background: var(--cobalt);
    box-shadow: inset 0 0 0 1px var(--cobalt);
  }

  @media (max-width: 720px) {
    .row > a:first-child {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 4px 10px;
      padding-block: 14px 16px;
    }

    .row-sum {
      -webkit-line-clamp: 2;
    }

    .row-meta {
      grid-column: 2;
      margin-top: 8px;
      text-align: left;
    }

    .row-repo {
      top: auto;
      bottom: 10px;
      transform: none;
    }
  }
</style>
