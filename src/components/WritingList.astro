---
import { monthYear, readMinutes, url, type Post } from '../lib/site';

interface Props {
  items: Post[];
}

const { items } = Astro.props;
---

<ol class="wlist">
  {
    items.map((p) => (
      <li class="wrow">
        <a class="wrow-link" href={url(`/writing/${p.id}/`)} data-win-link data-win-title={p.data.title}>
          <span class="wrow-date label">{monthYear(p.data.date)}</span>
          <span class="wrow-main">
            <span class="wrow-title">{p.data.title}</span>
            <span class="wrow-sum">{p.data.summary}</span>
          </span>
          <span class="wrow-side">
            <span class="wrow-read label">{readMinutes(p.body)} min</span>
            <span class="wrow-lights" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .wlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wrow {
    border-bottom: 1px solid var(--rule);
  }

  .wrow-link {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) 4.5rem;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.4rem 0.5rem;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.4s var(--ease-out);
  }

  .wrow-link:hover,
  .wrow-link:focus-visible {
    background: var(--paper-2);
  }

  .wrow-title {
    display: block;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .wrow-sum {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.93em;
    line-height: 1.5;
  }

  .wrow-side {
    position: relative;
    justify-self: end;
    text-align: right;
  }

  .wrow-read {
    transition: opacity 0.3s;
  }

  .wrow-lights {
    position: absolute;
    right: 0;
    top: 0.2rem;
    display: flex;
    gap: 5px;
  }

  .wrow-lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ff5f57;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.3s, transform 0.4s var(--ease-out);
  }

  .wrow-lights i:nth-child(2) {
    background: #febc2e;
    transition-delay: 0.04s;
  }

  .wrow-lights i:nth-child(3) {
    background: #28c840;
    transition-delay: 0.08s;
  }

  .wrow-link:hover .wrow-read {
    opacity: 0;
  }

  .wrow-link:hover .wrow-lights i {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .wrow-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.3rem 1rem;
    }

    .wrow-date {
      grid-column: 1;
    }

    .wrow-main {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .wrow-side {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
