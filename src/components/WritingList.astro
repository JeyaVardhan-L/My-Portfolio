---
import { monthYear, readMinutes, url, type Post } from '../lib/site';

interface Props {
  items: Post[];
}

const { items } = Astro.props;
---

<ol class="wl">
  {
    items.map((p) => (
      <li class="wr">
        <a href={url(`/writing/${p.id}/`)} data-win-link data-win-title={p.data.title}>
          <span class="label">{monthYear(p.data.date)}</span>
          <span class="wr-main">
            <span class="wr-title">{p.data.title}</span>
            <span class="wr-sum">{p.data.summary}</span>
          </span>
          <span class="wr-side">
            <span class="label wr-read">{readMinutes(p.body)} min</span>
            <span class="wr-lights" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .wl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .wr a {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 64px;
    gap: 16px;
    align-items: baseline;
    padding: 15px 12px;
    margin-inline: -12px;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: background 0.4s var(--ease);
  }

  .wr a:hover,
  .wr a:focus-visible {
    background: var(--bg-2);
  }

  .wr-title {
    display: block;
    font-size: clamp(17px, 1.3vw, 19px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .wr-sum {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 3px;
    max-width: 52em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .wr-side {
    position: relative;
    justify-self: end;
  }

  .wr-read {
    transition: opacity 0.3s;
  }

  .wr-lights {
    position: absolute;
    right: 0;
    top: 3px;
    display: flex;
    gap: 5px;
  }

  .wr-lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ff5f57;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.3s, transform 0.45s var(--ease);
  }

  .wr-lights i:nth-child(2) {
    background: #febc2e;
    transition-delay: 0.04s;
  }

  .wr-lights i:nth-child(3) {
    background: #28c840;
    transition-delay: 0.08s;
  }

  .wr a:hover .wr-read {
    opacity: 0;
  }

  .wr a:hover .wr-lights i {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 720px) {
    .wr a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
    }

    .wr-sum {
      -webkit-line-clamp: 2;
    }

    .wr-main {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
