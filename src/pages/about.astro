---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { Content as AboutText } from '../content/about.md';
import portrait from '../assets/portrait.jpg';
import { SITE } from '../site';
import { url } from '../lib/site';

const facts = [
  { k: 'Based in', v: `${SITE.location}` },
  { k: 'Studying', v: 'B.Tech, Computer Science, GITAM University' },
  { k: 'Now', v: SITE.now },
];
const links = [
  SITE.email && { label: 'Email', href: `mailto:${SITE.email}` },
  { label: 'GitHub', href: SITE.github },
  SITE.linkedin && { label: 'LinkedIn', href: SITE.linkedin },
  SITE.resume && { label: 'Résumé', href: url(SITE.resume) },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title="About" description={`About ${SITE.name}.`}>
  <section class="wrap about">
    <div class="about-grid">
      <div class="about-text">
        <p class="label rise">About</p>
        <div class="about-copy rise" style="--i: 1">
          <AboutText />
        </div>

        <dl class="facts rise" style="--i: 2">
          {
            facts.map((f) => (
              <div>
                <dt class="label">{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
          <div>
            <dt class="label">Elsewhere</dt>
            <dd class="links">
              {links.map((l) => <a href={l.href}>{l.label}</a>)}
            </dd>
          </div>
        </dl>

        <a class="door" href={url('/inspiration/')}>
          <span class="label">One more room</span>
          <span class="door-text">The pictures I keep coming back to <span aria-hidden="true">→</span></span>
        </a>
      </div>

      <figure class="about-photo rise" style="--i: 1">
        <Image src={portrait} alt={`Portrait of ${SITE.name}`} widths={[240, 480]} sizes="12rem" loading="eager" />
        <figcaption class="label" lang="te">{SITE.locationTe}</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .about {
    padding-top: clamp(3.5rem, 10vw, 7.5rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 35rem) 12rem;
    justify-content: center;
    align-items: start;
    gap: clamp(2.5rem, 7vw, 5.5rem);
  }

  .about-copy {
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-weight: 380;
    font-size: 1.05rem;
    line-height: 1.95;
    letter-spacing: 0.012em;
    color: var(--ink-2);
  }

  .about-copy :global(p + p) {
    margin-top: 1.15em;
  }

  .about-copy :global(a) {
    color: var(--ink);
  }

  .facts {
    margin: 3rem 0 0;
    font-family: var(--sans);
    font-size: 0.98rem;
  }

  .facts div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .facts dt {
    padding-top: 0.2rem;
  }

  .facts dd {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }

  .door {
    display: grid;
    gap: 0.35rem;
    margin-top: 4.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .door-text {
    font-family: var(--sans);
    letter-spacing: 0.02em;
  }

  .door-text span {
    display: inline-block;
    transition: transform 0.4s var(--ease-out);
  }

  .door:hover .door-text span {
    transform: translateX(5px);
  }

  .about-photo {
    margin: 2.5rem 0 0;
    position: sticky;
    top: 2rem;
  }

  .about-photo img {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .about-photo figcaption {
    margin-top: 0.7rem;
    text-transform: none;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      order: -1;
      width: 9.5rem;
      margin: 0;
      position: static;
    }
  }
</style>
