---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { Content as AboutText } from '../content/about.md';
import portrait from '../assets/portrait.jpg';
import { SITE } from '../site';
import { url } from '../lib/site';

const tel = SITE.phone ? `tel:${SITE.phone.replace(/[^\d+]/g, '')}` : '';
const contact = [
  SITE.email && { label: SITE.email, href: `mailto:${SITE.email}` },
  SITE.phone && { label: SITE.phone, href: tel },
].filter(Boolean) as { label: string; href: string }[];
const links = [
  { label: 'GitHub', href: SITE.github },
  SITE.linkedin && { label: 'LinkedIn', href: SITE.linkedin },
  SITE.resume && { label: 'Résumé', href: url(SITE.resume) },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title="About" description={`About ${SITE.name}.`}>
  <section class="wrap about">
    <div class="about-grid">
      <div>
        <p class="label rise">About</p>
        <div class="about-copy rise" style="--i: 1">
          <AboutText />
        </div>

        <dl class="facts rise" style="--i: 2">
          <div>
            <dt class="label">Based in</dt>
            <dd>{SITE.location}</dd>
          </div>
          <div>
            <dt class="label">Now</dt>
            <dd>{SITE.now}</dd>
          </div>
          {
            contact.length > 0 && (
              <div>
                <dt class="label">Contact</dt>
                <dd class="links">{contact.map((l) => <a href={l.href}>{l.label}</a>)}</dd>
              </div>
            )
          }
          <div>
            <dt class="label">Elsewhere</dt>
            <dd class="links">{links.map((l) => <a href={l.href}>{l.label}</a>)}</dd>
          </div>
        </dl>

        <a class="door" href={url('/inspiration/')}>
          <span class="label">One more room</span>
          <span class="door-text">The pictures I keep coming back to <i aria-hidden="true">/</i></span>
        </a>
      </div>

      <figure class="about-photo rise" style="--i: 1">
        <Image src={portrait} alt={`Portrait of ${SITE.name}`} widths={[260, 520]} sizes="13rem" loading="eager" />
        <figcaption class="label" lang="te">{SITE.locationTe}</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .about {
    padding-top: clamp(56px, 11vw, 136px);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 36rem) 13rem;
    justify-content: center;
    align-items: start;
    gap: clamp(40px, 8vw, 104px);
  }

  .about-copy {
    margin-top: 24px;
    font-size: 18px;
    font-weight: 350;
    line-height: 1.85;
    letter-spacing: 0.002em;
    color: var(--ink-2);
  }

  .about-copy :global(p + p) {
    margin-top: 1.1em;
  }

  .facts {
    margin: 56px 0 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }

  .facts dt {
    padding-top: 3px;
  }

  .facts dd {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .door {
    display: grid;
    gap: 8px;
    margin-top: 80px;
    text-decoration: none;
  }

  .door-text {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 22px;
    letter-spacing: -0.025em;
  }

  .door-text i {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--indigo);
    color: #fff;
    font: 500 13px/1 var(--mono);
    font-style: normal;
    transition: width 0.45s var(--ease);
  }

  .door:hover .door-text i {
    width: 48px;
  }

  .about-photo {
    position: sticky;
    top: 32px;
    margin: 40px 0 0;
  }

  .about-photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .about-photo figcaption {
    margin-top: 10px;
    text-transform: none;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      order: -1;
      position: static;
      width: 10rem;
      margin: 0;
    }
  }
</style>
