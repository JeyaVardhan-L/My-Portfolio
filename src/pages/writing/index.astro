---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { getPosts, url } from '../../lib/site';
import { SITE } from '../../site';

const posts = await getPosts();
---

<Base title="Writing" description={`Notes from building things, by ${SITE.name}.`}>
  <header class="wrap page-head">
    <p class="label">Writing · {posts.length} pieces · <a href={url('/rss.xml')}>RSS</a></p>
    <h1>Notes from building things.</h1>
    <p class="lede">What I tried, what broke and what I learned. Open one and it reads right here.</p>
  </header>
  <section class="wrap">
    {posts.length > 0 ? <WritingList items={posts} /> : <p class="label">Nothing here yet.</p>}
  </section>
</Base>
