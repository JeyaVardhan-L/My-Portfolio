---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Split from '../components/Split.astro';
import Plates from '../components/Plates.astro';
import WritingList from '../components/WritingList.astro';
import { SITE } from '../site';
import { getPosts, getProjects, onSide, url } from '../lib/site';

const projects = await getProjects();
const swCount = projects.filter((p) => onSide(p, 'software')).length;
const hwCount = projects.filter((p) => onSide(p, 'hardware')).length;
const swFeatured = projects.filter((p) => p.data.featured && onSide(p, 'software')).slice(0, 4);
const hwFeatured = projects.filter((p) => p.data.featured && onSide(p, 'hardware')).slice(0, 4);
const posts = (await getPosts()).slice(0, 4);
const sides = ['software', 'hardware'] as const;
---

<Base>
  <section class="hero">
    <div class="wrap hero-top label rise">
      <p>
        <span class="sw-only">{SITE.intro.software.fields}</span>
        <span class="hw-only">{SITE.intro.hardware.fields}</span>
      </p>
      <p class="hero-where">{SITE.location}<br />{SITE.coords}</p>
    </div>

    <div class="wrap hero-mid">
      {
        sides.map((s) => (
          <p class:list={['hero-statement rise', s === 'software' ? 'sw-only' : 'hw-only']} style="--i: 1">
            {SITE.intro[s].statement}
          </p>
        ))
      }
      <div class="hero-cta rise" style="--i: 2">
        <Btn label="See the work" href="#work" />
        <Btn label="About me" href={url('/about/')} ghost />
      </div>
    </div>

    <h1 class="wordmark" aria-label={SITE.name}>
      <span aria-hidden="true">{SITE.name}</span>
    </h1>

    <p class="side-label label" aria-hidden="true">
      <span class="sw-only">{SITE.intro.software.label}</span>
      <span class="hw-only">{SITE.intro.hardware.label}</span>
    </p>
  </section>

  <section class="wrap section" id="work">
    <Split left="Selected" right="work" />
    <div class="sw-only"><Plates items={swFeatured} /></div>
    <div class="hw-only"><Plates items={hwFeatured} /></div>
    <div class="more-row">
      <p class="label">
        <span class="sw-only">{swCount} projects on this side</span>
        <span class="hw-only">{hwCount} projects on this side</span>
      </p>
      <Btn label="All projects" href={url('/projects/')} />
    </div>
  </section>

  <section class="band">
    <div class="wrap band-in">
      <p class="label band-label">Now</p>
      <p class="band-text">{SITE.now}</p>
      <p class="band-vert" aria-hidden="true">Currently</p>
    </div>
  </section>

  <section class="wrap section hw-only">
    <Split left="On the" right="bench" />
    <dl class="bench">
      {
        SITE.bench.map((b) => (
          <div>
            <dt>{b.part}</dt>
            <dd class="label">{b.use}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    posts.length > 0 && (
      <section class="inv room">
        <div class="wrap">
          <Split left="Recent" right="writing" />
          <div class="room-list">
            <WritingList items={posts} />
          </div>
          <div class="more-row">
            <p class="label">Click one to read it right here</p>
            <Btn label="All writing" href={url('/writing/')} />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 28px;
  }

  .hero-where {
    text-align: right;
  }

  .hero-mid {
    flex: 1;
    padding-block: clamp(48px, 9vh, 112px) clamp(32px, 5vh, 56px);
  }

  .hero-statement {
    max-width: 21em;
    font-size: clamp(26px, 3.15vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .wordmark {
    display: flex;
    justify-content: center;
    margin: 0;
    font: 400 21.5vw/0.8 var(--serif);
    letter-spacing: -0.035em;
    white-space: nowrap;
    translate: 0 0.1em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wordmark span {
      animation: lift 1.6s var(--ease) both 0.15s;
    }
  }

  @keyframes lift {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }

  .side-label {
    position: absolute;
    right: 10px;
    top: 50%;
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
  }

  .more-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .band {
    margin-top: var(--gap);
    background: var(--indigo);
    color: var(--bone);
  }

  .band-in {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
    padding-block: clamp(80px, 12vw, 168px);
  }

  .band-label {
    color: var(--bone);
    opacity: 0.7;
  }

  .band-text {
    max-width: 15em;
    font-size: clamp(34px, 4.8vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .band-vert {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(80px, 12vw, 168px);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 18px;
    opacity: 0.7;
  }

  .bench {
    margin: 48px 0 0;
    border-bottom: 1px solid var(--rule);
  }

  .bench div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
  }

  .bench dt {
    font-size: clamp(20px, 1.9vw, 26px);
    letter-spacing: -0.025em;
  }

  .bench dd {
    margin: 0;
  }

  .room {
    margin-top: var(--gap);
    padding-block: var(--gap);
  }

  .room-list {
    margin-top: 56px;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
    }

    .hero-top {
      flex-direction: column;
    }

    .hero-where {
      text-align: left;
    }

    .side-label {
      display: none;
    }

    .band-in {
      grid-template-columns: 1fr;
    }

    .band-vert {
      display: none;
    }

    .more-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
