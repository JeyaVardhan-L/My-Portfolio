---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import ProjectRows from '../components/ProjectRows.astro';
import WritingList from '../components/WritingList.astro';
import Btn from '../components/Btn.astro';
import CanSat from '../components/CanSat.astro';
import Gallery from '../components/Gallery.astro';
import heroArt from '../assets/art/hero.jpg';
import { SITE } from '../site';
import { getPosts, getProjects, onSide, url } from '../lib/site';

const projects = await getProjects();
const sides = ['software', 'hardware'] as const;
const lists = Object.fromEntries(
  sides.map((s) => {
    const all = projects.filter((p) => onSide(p, s));
    const top = all.filter((p) => p.data.featured).slice(0, 2);
    const rest = all.filter((p) => !top.includes(p));
    return [s, { all, top, rest }];
  }),
) as Record<(typeof sides)[number], { all: typeof projects; top: typeof projects; rest: typeof projects }>;
const posts = (await getPosts()).slice(0, 4);
---

<Base>
  <section class="hero">
    <div class="wrap hero-hud label rise">
      <p>
        <span class="sw-only">{SITE.intro.software.fields}</span>
        <span class="hw-only">{SITE.intro.hardware.fields}</span>
      </p>
      <p class="hero-where">{SITE.location}<br />{SITE.coords}</p>
    </div>

    <h1 class="name rise" style="--i: 1">{SITE.name}</h1>
    <p class="label hero-side rise" style="--i: 2">
      <span class="sw-only">{SITE.intro.software.label}</span>
      <span class="hw-only">{SITE.intro.hardware.label}</span>
    </p>

    <Art src={heroArt} variant="hero" eager />

    <div class="wrap hero-foot label">
      {SITE.now ? <p class="hero-now"><i aria-hidden="true"></i>Now · {SITE.now}</p> : <span />}
      <a href="#work">Scroll ↓</a>
    </div>
  </section>

  <section class="wrap section" id="work">
    <div class="sec-head">
      <h2 class="h-serif">Selected work</h2>
      <a class="label" href={url('/projects/')}>Full index →</a>
    </div>
    {
      sides.map((s) => (
        <div class={s === 'software' ? 'sw-only' : 'hw-only'}>
          <ProjectRows items={lists[s].top} />
          {lists[s].rest.length > 0 && (
            <>
              <div class="more-wrap" id={`more-${s}`}>
                <div>
                  <ProjectRows items={lists[s].rest} start={lists[s].top.length + 1} />
                </div>
              </div>
              <div class="more-row">
                <button class="more-btn" type="button" data-more={`more-${s}`} aria-expanded="false" aria-controls={`more-${s}`}>
                  <span class="t-open">See {lists[s].rest.length} more</span>
                  <span class="t-close">Show less</span>
                  <i aria-hidden="true">+</i>
                </button>
                <p class="label">{lists[s].all.length} projects on this side</p>
              </div>
            </>
          )}
        </div>
      ))
    }
  </section>

  <section class="wrap section hw-only">
    <div class="sec-head">
      <h2 class="h-serif">On the bench</h2>
      <p class="label">What I am building now</p>
    </div>
    <div class="build">
      <div class="build-text">
        <p class="label build-flag"><i aria-hidden="true"></i>{SITE.bench.status}</p>
        <h3 class="build-title">{SITE.bench.title}</h3>
        <p class="build-sum">{SITE.bench.summary}</p>
        <dl class="build-specs">
          {
            SITE.bench.specs.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <figure class="build-fig">
        <CanSat />
      </figure>
    </div>
  </section>

  <section class="wrap section gal-band">
    <div class="gal-row">
      <div>
        <p class="label">Gallery</p>
        <p class="gal-note">Builds, tests and places, floating on a sphere you can spin.</p>
      </div>
      <Btn label="Gallery" data-gallery-open="" />
    </div>
  </section>
  <Gallery />

  {
    posts.length > 0 && (
      <section class="room writing">
        <div class="wrap">
          <div class="sec-head">
            <h2 class="h-serif">Recent writing</h2>
            <a class="label" href={url('/writing/')}>
              All writing →
            </a>
          </div>
          <WritingList items={posts} />
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 58px);
    overflow: hidden;
  }

  .hero-hud {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
  }

  .hero-where {
    text-align: right;
  }

  .name {
    position: relative;
    z-index: 2;
    margin-top: clamp(20px, 6vh, 88px);
    text-align: center;
    white-space: nowrap;
    font: 400 clamp(52px, 12.5vw, 240px) / 0.9 var(--serif);
    letter-spacing: -0.015em;
    color: var(--blue);
  }

  .hero-side {
    position: relative;
    z-index: 2;
    margin-top: 18px;
    text-align: center;
  }

  .hero :global(.art--hero) {
    flex: 1;
    min-height: 280px;
    margin-top: calc(-0.03 * 100vw);
  }

  /* Tall on purpose: the calm sky is room for the name, a tagline and
     a few lines about me. */
  .hero :global(.art--hero .art-in) {
    height: 100%;
    min-height: clamp(360px, 76vh, 940px);
  }

  .hero :global(.art--hero img) {
    object-position: 50% 62%;
  }

  .hero-foot {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 16px 18px;
  }

  .hero-foot a {
    text-decoration: none;
  }

  .hero-foot a:hover {
    color: var(--ink);
  }

  .hero-now {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
  }

  .hero-now i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
  }

  .more-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
  }

  .build {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding-top: 28px;
  }

  .build-flag {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--blue);
  }

  .build-flag i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    animation: blink 1.6s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      opacity: 0.2;
    }
  }

  .build-title {
    margin-top: 10px;
    font: 400 clamp(38px, 4.4vw, 60px) / 1 var(--serif);
    color: var(--blue);
  }

  .build-sum {
    margin-top: 14px;
    max-width: 32em;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .build-specs {
    margin: 22px 0 0;
    border-top: 1px solid var(--rule);
  }

  .build-specs div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
  }

  .build-specs dd {
    margin: 0;
    font-size: 14px;
  }

  .build-fig {
    margin: 0;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .build-fig :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .gal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    padding: 18px 0;
    border-block: 1px solid var(--rule);
  }

  .gal-note {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 15px;
  }

  .writing {
    margin-top: var(--gap);
    padding-block: clamp(80px, 10vw, 136px);
  }

  .writing :global(.wl) {
    border-bottom: 0;
  }

  /* Portrait screens of any width (phones, including desktop-site mode, and
     tablets): size the hero to its content so no empty band opens up. */
  @media (max-width: 720px), (orientation: portrait) {
    .hero {
      min-height: auto;
    }

    .hero :global(.art--hero) {
      flex: none;
      min-height: 0;
      margin-top: -4vw;
    }

    .hero :global(.art--hero .art-in) {
      min-height: 0;
      height: clamp(320px, 96vw, 860px);
    }

    .hero :global(.art--hero img) {
      object-position: 62% 60%;
    }
  }

  @media (max-width: 720px) {

    .hero-hud {
      flex-direction: column;
      gap: 8px;
    }

    .hero-where {
      text-align: left;
    }

    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .more-row,
    .gal-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 900px) {
    .build {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
