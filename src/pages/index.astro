---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import WritingList from '../components/WritingList.astro';
import PipelineDiagram from '../components/PipelineDiagram.astro';
import GimbalDiagram from '../components/GimbalDiagram.astro';
import { SITE } from '../site';
import { getPosts, getProjects, onSide, url } from '../lib/site';

const projects = await getProjects();
const swCount = projects.filter((p) => onSide(p, 'software')).length;
const hwCount = projects.filter((p) => onSide(p, 'hardware')).length;
const swFeatured = projects.filter((p) => p.data.featured && onSide(p, 'software')).slice(0, 4);
const hwFeatured = projects.filter((p) => p.data.featured && onSide(p, 'hardware')).slice(0, 4);
const posts = (await getPosts()).slice(0, 3);
const contactLinks = [
  { label: 'GitHub', href: SITE.github },
  SITE.linkedin && { label: 'LinkedIn', href: SITE.linkedin },
  SITE.resume && { label: 'Résumé', href: url(SITE.resume) },
].filter(Boolean) as { label: string; href: string }[];
---

<Base>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="label rise">
        <span class="sw-only">{SITE.intro.software.kicker}</span>
        <span class="hw-only">{SITE.intro.hardware.kicker}</span>
      </p>
      <h1 class="rise" style="--i: 1">
        <span class="sw-only" set:html={SITE.intro.software.headline} />
        <span class="hw-only" set:html={SITE.intro.hardware.headline} />
      </h1>
      <p class="lede rise sw-only" style="--i: 2">{SITE.intro.software.body}</p>
      <p class="lede rise hw-only" style="--i: 2">{SITE.intro.hardware.body}</p>
      <p class="now rise" style="--i: 3">
        <span class="pulse" aria-hidden="true"></span>
        <span class="label label--ink">Now</span>
        <span class="now-text">{SITE.now}</span>
      </p>
    </div>
    <figure class="hero-fig rise" style="--i: 2">
      <div class="plate dotgrid">
        <div class="sw-only"><PipelineDiagram /></div>
        <div class="hw-only"><GimbalDiagram /></div>
      </div>
      <figcaption class="label">
        <span class="sw-only">Fig. 1 — A pipeline, the way ForgeShell runs it</span>
        <span class="hw-only">Fig. 1 — The IMU behind my flight telemetry and the Air Mouse</span>
      </figcaption>
    </figure>
  </section>

  <section class="wrap section" id="work">
    <div class="section-head">
      <h2>Selected work</h2>
      <a class="more" href={url('/projects/')}>
        All <span class="sw-only">{swCount}</span><span class="hw-only">{hwCount}</span> projects <span>→</span>
      </a>
    </div>
    <div class="sw-only"><ProjectList items={swFeatured} /></div>
    <div class="hw-only"><ProjectList items={hwFeatured} /></div>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap section sw-only" id="writing">
        <div class="section-head">
          <h2>Writing</h2>
          <a class="more" href={url('/writing/')}>
            All writing <span>→</span>
          </a>
        </div>
        <WritingList items={posts} />
      </section>
    )
  }

  <section class="wrap section hw-only">
    <div class="section-head">
      <h2>On the bench</h2>
      <span class="label">Parts that keep showing up</span>
    </div>
    <dl class="bench">
      {
        SITE.bench.map((b) => (
          <div class="bench-row">
            <dt>{b.part}</dt>
            <dd class="label">{b.use}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap section hw-only">
    <div class="crossover">
      <p>Most of what I build is software. The bigger half of this site is on the other side.</p>
      <button class="crossover-btn" type="button" data-side-set="software">
        Back to the software side <span aria-hidden="true">→</span>
      </button>
    </div>
  </section>

  <section class="wrap section contact" id="contact">
    <p class="label">Contact</p>
    <p class="contact-line">
      {
        SITE.email ? (
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        ) : (
          <a href={SITE.github} rel="me noopener">
            Say hello on GitHub ↗
          </a>
        )
      }
    </p>
    <p class="contact-note">I'm looking for internships, and for people who like building things properly.</p>
    <ul class="contact-links label">
      {
        contactLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label} ↗</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
    padding-top: clamp(3.5rem, 9vw, 7rem);
  }

  .hero h1 {
    margin-top: 1.4rem;
    font-size: clamp(2.7rem, 1.6rem + 4.2vw, 4.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero .lede {
    margin-top: 1.6rem;
  }

  .now {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    margin-top: 2.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    max-width: 34rem;
  }

  .now-text {
    font-style: italic;
    color: var(--ink-2);
  }

  .pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    align-self: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent);
      animation: ping 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes ping {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero-fig {
    margin: 0;
  }

  .plate {
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }

  .hero-fig figcaption {
    margin-top: 0.8rem;
  }

  .bench {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 4rem);
    margin: 0;
  }

  .bench-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .bench-row dd {
    margin: 0;
    text-align: right;
  }

  .crossover {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .crossover p {
    max-width: 30rem;
    font-size: 1.15em;
  }

  .crossover-btn {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    transition: background 0.3s, color 0.3s;
  }

  .crossover-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .contact-line {
    margin-top: 1.2rem;
    font-size: clamp(2.1rem, 1rem + 5vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .contact-line a {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .contact-note {
    margin-top: 1.5rem;
    max-width: 32rem;
    color: var(--muted);
  }

  .contact-links {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .contact-links a {
    text-decoration: none;
  }

  .contact-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .bench {
      grid-template-columns: 1fr;
    }
  }
</style>
