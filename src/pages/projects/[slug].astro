---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Btn from '../../components/Btn.astro';
import Diagram from '../../components/Diagram.astro';
import { diagramOf, getProjects, monthYear, sideLabel, url, type Project } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

interface Props {
  entry: Project;
  prev: Project | null;
  next: Project | null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const hasDiagram = Boolean(diagramOf(entry.id));
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, format: 'jpg' })).src : undefined;
---

<Base title={d.title} description={d.summary} image={og} article>
  <article>
    <header class="wrap ph">
      <div class="ph-top label rise">
        <a href={url('/projects/')}>← All work</a>
        <span>{sideLabel[d.side]} · {monthYear(d.date)}{d.status !== 'shipped' && ` · ${d.status}`}</span>
      </div>
      <h1 class="display ph-title rise" style="--i: 1">{d.title}</h1>
      <div class="ph-row rise" style="--i: 2">
        <p class="lede">{d.summary}</p>
        <div class="ph-btns">
          {d.demo && <Btn label="Live site" href={d.demo} />}
          {d.repo && <Btn label="GitHub repo" href={d.repo} ghost={Boolean(d.demo)} />}
        </div>
      </div>
    </header>

    {
      d.cover ? (
        <figure class="wrap ph-cover rise" style="--i: 3">
          <Image src={d.cover} alt={`${d.title}, cover image`} widths={[720, 1200, 1800]} sizes="(min-width: 1340px) 1240px, 100vw" loading="eager" />
        </figure>
      ) : (
        hasDiagram && (
          <figure class="wrap ph-drawn rise" style="--i: 3">
            <Diagram id={entry.id} />
          </figure>
        )
      )
    }

    <div class="wrap ph-grid">
      <aside class="specs">
        {
          d.specs.length > 0 && (
            <dl>
              {d.specs.map((s) => (
                <div>
                  <dt class="label">{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          d.tags.length > 0 && (
            <ul class="tags">
              {d.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          )
        }
      </aside>

      <div class="ph-body">
        {
          d.cover && hasDiagram && (
            <figure class="ph-fig">
              <Diagram id={entry.id} />
              <figcaption class="label">Fig. 1 — How it works</figcaption>
            </figure>
          )
        }
        <div class="prose">
          <Content />
        </div>
        {
          d.gallery.length > 0 && (
            <div class="gallery">
              {d.gallery.map((g) => (
                <figure>
                  <Image src={g.src} alt={g.caption} widths={[480, 900]} sizes="(min-width: 900px) 44rem, 100vw" />
                  {g.caption && <figcaption class="label">{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <nav class="wrap pager" aria-label="More projects">
      {
        prev ? (
          <a href={url(`/projects/${prev.id}/`)}>
            <span class="label">← Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="next" href={url(`/projects/${next.id}/`)}>
            <span class="label">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .ph {
    padding-top: 28px;
  }

  .ph-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .ph-top a {
    text-decoration: none;
  }

  .ph-top a:hover {
    color: var(--ink);
  }

  .ph-title {
    margin-top: clamp(40px, 7vw, 88px);
  }

  .ph-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px 48px;
    margin-top: 28px;
  }

  .ph-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ph-cover {
    margin-top: clamp(48px, 7vw, 88px);
    margin-bottom: 0;
  }

  .ph-cover :global(img) {
    width: 100%;
    height: auto;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .ph-drawn {
    margin-top: clamp(48px, 7vw, 88px);
    margin-bottom: 0;
    max-width: 980px;
  }

  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(64px, 9vw, 120px);
  }

  .specs {
    position: sticky;
    top: 24px;
    align-self: start;
    display: grid;
    gap: 32px;
  }

  .specs dl {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }

  .specs dl div {
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }

  .specs dd {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.4;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ph-fig {
    margin: 0 0 56px;
    max-width: 44rem;
  }

  .ph-fig figcaption {
    margin-top: 12px;
  }

  .gallery {
    display: grid;
    gap: 40px;
    max-width: 44rem;
    margin-top: 56px;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
  }

  .gallery figcaption {
    margin-top: 10px;
    text-transform: none;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: var(--gap);
  }

  .pager a {
    display: grid;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }

  .pager .next {
    text-align: right;
  }

  .pager-title {
    font: 400 clamp(26px, 2.8vw, 40px) / 1 var(--serif);
    color: var(--blue);
  }

  @media (max-width: 860px) {
    .ph-grid {
      grid-template-columns: 1fr;
    }

    .specs {
      position: static;
    }
  }
</style>
