---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects, onSide } from '../../lib/site';
import { SITE } from '../../site';

const projects = await getProjects();
const swCount = projects.filter((p) => onSide(p, 'software')).length;
const hwCount = projects.filter((p) => onSide(p, 'hardware')).length;
---

<Base title="Work" description={`Projects by ${SITE.name}: systems software, robotics, vision, XR and hardware.`}>
  <header class="wrap head">
    <p class="label rise">
      Index · <span class="sw-only">Software side · {swCount} projects</span><span class="hw-only">Hardware side · {hwCount} projects</span>
    </p>
    <h1 class="display rise" style="--i: 1">Work</h1>
    <p class="lede rise" style="--i: 2">
      <span class="sw-only">Software, and the projects where software and hardware meet.</span>
      <span class="hw-only">Things with wires, motors and solder, and the code that runs them.</span>
      {" "}Use the switch at the top to see the other side.
    </p>
  </header>
  <section class="wrap">
    <ProjectList items={projects} filterBySide />
    <p class="label after">
      Smaller experiments and coursework live on <a href={SITE.github}>GitHub</a>.
    </p>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(48px, 9vw, 112px) 56px;
  }

  .head .display {
    margin-top: 24px;
  }

  .head .lede {
    margin-top: 28px;
  }

  .after {
    margin-top: 24px;
  }
</style>
