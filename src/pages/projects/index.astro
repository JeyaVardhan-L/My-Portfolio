---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects, onSide } from '../../lib/site';
import { SITE } from '../../site';

const projects = await getProjects();
const swCount = projects.filter((p) => onSide(p, 'software')).length;
const hwCount = projects.filter((p) => onSide(p, 'hardware')).length;
---

<Base title="Work" description={`Projects by ${SITE.name}: systems software, robotics, computer vision, XR and hardware.`}>
  <header class="wrap page-head">
    <p class="label">
      Work · <span class="sw-only">Software side</span><span class="hw-only">Hardware side</span>
    </p>
    <h1>Things I've built.</h1>
    <p class="lede sw-only">
      Software, and the projects where software drives hardware. {swCount} so far, with the ones I'd show you first at the top.
      <button class="inline-btn" type="button" data-side-set="hardware">See the hardware side</button>
    </p>
    <p class="lede hw-only">
      The projects with solder on them. {hwCount} so far.
      <button class="inline-btn" type="button" data-side-set="software">See the software side</button>
    </p>
  </header>
  <section class="wrap">
    <ProjectList items={projects} filterBySide />
    <p class="label after">
      Smaller experiments and coursework live on <a href={SITE.github}>GitHub ↗</a>
    </p>
  </section>
</Base>

<style>
  .after {
    margin-top: 2rem;
  }
</style>
