---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import RadarDiagram from '../components/RadarDiagram.astro';
import { url } from '../lib/site';
---

<Base title="Not found">
  <section class="wrap lost">
    <div class="scope"><RadarDiagram /></div>
    <p class="label">Error 404</p>
    <h1>Nothing on the scope at this address.</h1>
    <div class="cta"><Btn label="Back home" href={url('/')} /></div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: clamp(48px, 9vw, 112px);
  }

  .scope {
    width: min(240px, 64vw);
    margin-bottom: 40px;
  }

  .lost h1 {
    margin-top: 16px;
    max-width: 14em;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .cta {
    margin-top: 32px;
  }
</style>
